rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowPath() { return /databases/$(database)/documents/allowedUsers/$(request.auth.uid); }
    function approved() { return request.auth != null && exists(allowPath()); }
    function householdMember(hid) {
      return approved() && get(allowPath()).data.householdId == hid
        && exists(/databases/$(database)/documents/households/$(hid))
        && get(/databases/$(database)/documents/households/$(hid)).data.members.size() == 2
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }
    function deliveryMember(ownerUid) {
      return approved()
        && exists(/databases/$(database)/documents/households/$(get(allowPath()).data.householdId))
        && get(/databases/$(database)/documents/households/$(get(allowPath()).data.householdId)).data.members.size() == 2
        && request.auth.uid in get(/databases/$(database)/documents/households/$(get(allowPath()).data.householdId)).data.members
        && get(/databases/$(database)/documents/households/$(get(allowPath()).data.householdId)).data.ownerUid == ownerUid;
    }
    function money(n) { return n is int && n >= 0 && n <= 1000000000000; }
    function date(s) { return s is string && s.matches('^\\d{4}-((0[13578]|1[02])-(0[1-9]|[12]\\d|3[01])|(0[469]|11)-(0[1-9]|[12]\\d|30)|02-(0[1-9]|1\\d|2[0-9]))$'); }
    function month(s) { return s is string && s.matches('^\\d{4}-(0[1-9]|1[0-2])$'); }
    function text(s, max) { return s is string && s.size() <= max; }
    function stamps(d) { return d.createdAt is timestamp && d.updatedAt is timestamp; }
    function transaction(d) {
      return d.keys().hasAll(['person','type','title','amount','date','category','paymentMethod','account','memo','paid','paidDate','recurringRuleId','createdAt','updatedAt'])
        && d.keys().hasOnly(['person','type','title','amount','date','category','paymentMethod','account','memo','paid','paidDate','recurringRuleId','sortOrder','createdAt','updatedAt'])
        && d.person in ['y','s'] && d.type in ['income','expense','savings','transfer','loanPrincipal','loanInterest']
        && text(d.title,100) && d.title.size() > 0 && money(d.amount) && date(d.date)
        && text(d.category,80) && text(d.paymentMethod,80) && text(d.account,80)
        && text(d.memo,150) && d.paid is bool && (d.paidDate == '' || date(d.paidDate))
        && text(d.recurringRuleId,120) && (!d.keys().hasAll(['sortOrder']) || (d.sortOrder is int && d.sortOrder >= 0 && d.sortOrder <= 1000000000)) && stamps(d);
    }
    function recurring(d) {
      return d.keys().hasAll(['person','type','title','amount','category','paymentMethod','account','memo','startMonth','endMonth','day','installments','createdAt','updatedAt'])
        && d.keys().hasOnly(['person','type','title','amount','category','paymentMethod','account','memo','startMonth','endMonth','day','installments','sortOrder','createdAt','updatedAt'])
        && d.person in ['y','s'] && d.type in ['income','expense','savings','transfer','loanPrincipal','loanInterest']
        && text(d.title,100) && d.title.size() > 0 && money(d.amount)
        && text(d.category,80) && text(d.paymentMethod,80) && text(d.account,80) && text(d.memo,150)
        && month(d.startMonth) && (d.endMonth == '' || month(d.endMonth))
        && d.day is int && d.day >= 1 && d.day <= 31
        && d.installments is int && d.installments >= 0 && d.installments <= 120
        && (!d.keys().hasAll(['sortOrder']) || (d.sortOrder is int && d.sortOrder >= 0 && d.sortOrder <= 1000000000)) && stamps(d);
    }
    function cardDetail(d) {
      return d.keys().hasAll(['cardKey','cardName','person','date','title','category','amount','memo','createdAt','updatedAt'])
        && d.keys().hasOnly(['cardKey','cardName','person','date','title','category','amount','memo','createdAt','updatedAt'])
        && d.cardKey in ['shinhan-y','hyundai-y','samsung-s','living-common']
        && ((d.cardKey == 'shinhan-y' && d.cardName == '신한카드' && d.person == 'y') || (d.cardKey == 'hyundai-y' && d.cardName == '현대카드' && d.person == 'y') || (d.cardKey == 'samsung-s' && d.cardName == '삼성카드' && d.person == 's') || (d.cardKey == 'living-common' && d.cardName == '생활비 카드' && d.person == 'common'))
        && date(d.date) && text(d.title,100) && d.title.size() > 0 && text(d.category,80) && d.category.size() > 0
        && money(d.amount) && text(d.memo,150) && stamps(d);
    }
    function audit(d) {
      return d.keys().hasAll(['actorUid','action','target','summary','createdAt'])
        && d.keys().hasOnly(['actorUid','action','target','summary','createdAt'])
        && d.actorUid == request.auth.uid
        && d.action in ['등록','수정','삭제','상태 변경','순서 변경']
        && d.target in ['가계부 기록','반복 거래','부업 기록','카드 상세 내역']
        && text(d.summary,160) && d.summary.size() > 0
        && d.createdAt is timestamp && d.createdAt == request.time;
    }
    function earning(d, uid) {
      return d.keys().hasAll(['ownerUid','kind','platform','workDate','workMonth','grossIncome','settlementDeduction','deliveryCount','workHours','distanceKm','memo','createdAt','updatedAt'])
        && d.keys().hasOnly(['ownerUid','kind','platform','workDate','workMonth','grossIncome','settlementDeduction','deliveryCount','workHours','distanceKm','memo','createdAt','updatedAt'])
        && d.ownerUid == uid && d.kind == 'income' && d.platform in ['쿠팡이츠','배민커넥트']
        && date(d.workDate) && month(d.workMonth) && d.workMonth == d.workDate[0:7]
        && money(d.grossIncome) && money(d.settlementDeduction) && d.settlementDeduction <= d.grossIncome
        && d.deliveryCount is int && d.deliveryCount >= 0 && d.deliveryCount <= 1000000
        && d.workHours is number && d.workHours >= 0 && d.workHours <= 1000000
        && d.distanceKm is number && d.distanceKm >= 0 && d.distanceKm <= 1000000
        && text(d.memo,150) && stamps(d);
    }
    function cost(d, uid, kind) {
      return d.keys().hasAll(['ownerUid','kind','workDate','workMonth','amount','category','memo','createdAt','updatedAt'])
        && d.keys().hasOnly(['ownerUid','kind','workDate','workMonth','amount','category','memo','createdAt','updatedAt'])
        && d.ownerUid == uid && d.kind == kind && (date(d.workDate) || (kind == 'investment' && d.workDate == ''))
        && ((month(d.workMonth) && d.workMonth == d.workDate[0:7]) || (kind == 'investment' && d.workMonth == ''))
        && money(d.amount) && text(d.category,80) && d.category.size() > 0 && text(d.memo,150) && stamps(d);
    }
    match /allowedUsers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /households/{hid} {
      allow get: if householdMember(hid);
      allow list, write: if false;
      match /transactions/{id} {
        allow read: if householdMember(hid);
        allow create: if householdMember(hid) && transaction(request.resource.data);
        allow update: if householdMember(hid) && transaction(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.recurringRuleId == resource.data.recurringRuleId;
        allow delete: if householdMember(hid);
      }
      match /recurringRules/{id} {
        allow read: if householdMember(hid);
        allow create: if householdMember(hid) && recurring(request.resource.data);
        allow update: if householdMember(hid) && recurring(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if householdMember(hid);
      }
      match /auditLogs/{id} {
        allow read: if householdMember(hid);
        allow create: if householdMember(hid) && audit(request.resource.data);
        allow update, delete: if false;
      }
      match /cardDetails/{id} {
        allow read: if householdMember(hid);
        allow create: if householdMember(hid) && cardDetail(request.resource.data);
        allow update: if householdMember(hid) && cardDetail(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if householdMember(hid);
      }
    }
    match /users/{uid} {
      allow read, write: if false;
      match /deliveryEarnings/{id} {
        allow read: if deliveryMember(uid);
        allow create: if deliveryMember(uid) && earning(request.resource.data, uid);
        allow update: if deliveryMember(uid) && earning(request.resource.data, uid)
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if deliveryMember(uid);
      }
      match /deliveryExpenses/{id} {
        allow read: if deliveryMember(uid);
        allow create: if deliveryMember(uid) && cost(request.resource.data, uid, 'expense');
        allow update: if deliveryMember(uid) && cost(request.resource.data, uid, 'expense')
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if deliveryMember(uid);
      }
      match /deliveryInvestments/{id} {
        allow read: if deliveryMember(uid);
        allow create: if deliveryMember(uid) && cost(request.resource.data, uid, 'investment');
        allow update: if deliveryMember(uid) && cost(request.resource.data, uid, 'investment')
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if deliveryMember(uid);
      }
      match /settings/{id} {
        allow read: if approved() && request.auth.uid == uid;
        allow create: if approved() && request.auth.uid == uid && id == 'app'
          && request.resource.data.keys().hasAll(['ownerUid','displayName','defaultPlatform','createdAt','updatedAt'])
          && request.resource.data.keys().hasOnly(['ownerUid','displayName','defaultPlatform','createdAt','updatedAt'])
          && request.resource.data.ownerUid == uid && text(request.resource.data.displayName,40)
          && request.resource.data.defaultPlatform in ['쿠팡이츠','배민커넥트'] && stamps(request.resource.data);
        allow update: if approved() && request.auth.uid == uid && id == 'app'
          && request.resource.data.keys().hasAll(['ownerUid','displayName','defaultPlatform','createdAt','updatedAt'])
          && request.resource.data.keys().hasOnly(['ownerUid','displayName','defaultPlatform','createdAt','updatedAt'])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && text(request.resource.data.displayName,40)
          && request.resource.data.defaultPlatform in ['쿠팡이츠','배민커넥트'] && stamps(request.resource.data);
        allow delete: if false;
      }
    }
  }
}
